// Bluetooth Offload APK

android_app {
    name: "Bluetooth_Offload",

    srcs: [
        "src/**/*.java",
    ],

    platform_apis: true,
    certificate: "platform",

    libs: [
        "services.net",
    ],
    static_libs: [
        "services.net",
        "androidx.core_core",
        "androidx.lifecycle_lifecycle-livedata",
        "androidx.room_room-runtime",
		"vendor.qti.hardware.bluetooth_offload-V1.0-java",
    ],

    plugins: [
        "androidx.room_room-compiler-plugin",
    ],

    optimize: {
        enabled: false,
    },
}