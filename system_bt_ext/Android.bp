soong_config_module_type {
    name: "bluetooth_ext_bredr_vs_btadva_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "bredr_vs_btadva",
    variables: ["bredr_or_btadva"],
    // Properties can be extended to other properties as well
    properties: ["cflags", "include_dirs", "static_libs", "whole_static_libs", "srcs", "header_libs"],
}

soong_config_string_variable {
    name: "bredr_or_btadva",
    values: ["bredr", "btadva"],
}

soong_config_module_type {
    name: "bluetooth_ext_aosp_vs_qva_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "aosp_vs_qva",
    variables: ["aosp_or_qva"],
    // Properties can be extended to other properties as well
    properties: ["libs", "static_libs", "shared_libs", "whole_static_libs"],
}

soong_config_string_variable {
    name: "aosp_or_qva",
    values: ["aosp", "qva"],
}

soong_config_module_type {
    name: "bluetooth_ext_bredr_vs_btadva_java_defaults",
    module_type: "java_defaults",
    config_namespace: "bredr_vs_btadva",
    variables: ["bredr_or_btadva"],
    // Properties can be extended to other properties as well
    properties: ["cflags", "include_dirs", "static_libs", "whole_static_libs", "srcs"],
}

soong_config_module_type {
    name: "bluetooth_ext_aosp_vs_qva_java_defaults",
    module_type: "java_defaults",
    config_namespace: "aosp_vs_qva",
    variables: ["aosp_or_qva"],
    // Properties can be extended to other properties as well
    properties: ["libs", "static_libs"],
}

subdirs = [
    "device",
    "btif",
    "stack",
    "osi",
    "stack",
    "bta",
    "btconfigstore",
]

cc_library_headers {
   name: "opensource_commonsys_bt_ext_all_inc",
   vendor_available: true,
   export_include_dirs: [
	    "btif/include",
		"bta/include",
		"bta/lpm",
		"device/include",
		"stack/include",
		"stack/lpm",
		"stack/btm",
		"btconfigstore",
		"include",
		".",
	],
}
