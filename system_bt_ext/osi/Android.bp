// libbtif_ext static library for target
// ========================================================

soong_config_module_type_import {
    from: "vendor/qcom/opensource/commonsys/bluetooth_ext/system_bt_ext/Android.bp",
    module_types: [
         "bluetooth_ext_aosp_vs_qva_cc_defaults",
    ],
}
bluetooth_ext_aosp_vs_qva_cc_defaults {
     name: "qva_osi_cc_defaults",
     soong_config_variables: {
         aosp_or_qva: {
           qva: {
             static_libs: [
               "libosi",
               "libbt-utils",
             ],
           }
        }
    }
}

cc_library_static {
    name: "libosi_ext",
    defaults: ["fluoride_defaults_qti", "qva_osi_cc_defaults"],
    header_libs: ["opensource_commonsys_system_bt_all_inc", "opensource_commonsys_bt_ext_all_inc",],
    srcs: [
        "src/vnd_log.cc",
    ],
    shared_libs: [
        "libcutils",
        "libutils",
        "libhardware",
    ],
    cflags: ["-DBUILDCFG"],
}
