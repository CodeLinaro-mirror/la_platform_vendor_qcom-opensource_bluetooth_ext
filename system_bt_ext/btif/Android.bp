soong_config_module_type_import {
    from: "vendor/qcom/opensource/monaco/commonsys/bluetooth_ext/system_bt_ext/Android.bp",
    module_types: [
         "bluetooth_ext_bredr_vs_btadva_cc_defaults",
    ],
}

bluetooth_ext_bredr_vs_btadva_cc_defaults {
    name: "btadva_bluetooth_ext_cc-default",

    soong_config_variables: {
        bredr_or_btadva: {
           btadva: {
              cflags: [
                 "-DADV_AUDIO_FEATURE=1",
              ],
           }
       }
   }
}

// libbtif_ext static library for target
// ========================================================
cc_library_static {
    name: "libbtif_ext",
    defaults: ["fluoride_defaults_qti", "btadva_bluetooth_ext_cc-default"],
	header_libs: [
	    "opensource_btext_vhal_inc",
		"opensource_commonsys_system_bt_all_inc",
		"opensource_commonsys_bt_ext_all_inc",
		"opensource_commonsys_intf_bluetooth_inc",
	],
    srcs: [
        //"src/btif_l2cap.cc",
        //"src/btif_rfcomm.cc",
        "src/btif_vendor.cc",
        "src/btif_vendor_socket.cc",
        //"src/btif_gap.cc",
        //"src/btif_gatt_qual.cc",
        //"src/btif_smp.cc",
        //"src/btif_tws_plus.cc",
        //"src/btif_ba.cc",
        //"src/btif_twsp_hf.cc",
        //"src/btif_iot_config.cc",
        //"src/btif_vendor_hf.cc",
    ],
    shared_libs: [
        "libcutils",
        "libchrome",
        "libbase",
        "libutils",
        "libhardware",
    ],
    static_libs: [
        "libosi_qti",
        "libbt-utils_qti",
        "libbluetooth-types",
    ],
    cflags: [
        "-DBUILDCFG",
        "-DHAS_NO_BDROID_BUILDCFG",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
        "-Wno-unused-private-field"
    ],

}
