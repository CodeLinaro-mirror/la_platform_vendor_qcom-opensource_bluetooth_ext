// Bluetooth device static library for target
// ========================================================
cc_library_static {
    name: "libbtdevice_ext",
    defaults: ["fluoride_defaults_qti"],
    local_include_dirs: [
        "include",
    ],
	header_libs: [
	    "opensource_btext_vhal_inc",
		"opensource_commonsys_system_bt_all_inc",
	],
    srcs: [
        "src/interop.cc",
        "src/profile_config.cc",
        "src/device_iot_config.cc",
    ],
    shared_libs: [
        "liblog",
    ],
    static_libs: [
        "libosi_qti",
        "libbluetooth-types",
    ],
}
