// libbt-bta-ext static library for target
// ========================================================

soong_config_module_type_import {
    from: "vendor/qcom/opensource/monaco/commonsys/bluetooth_ext/system_bt_ext/Android.bp",
    module_types: [
         "bluetooth_ext_aosp_vs_qva_cc_defaults",
    ],
}
bluetooth_ext_aosp_vs_qva_cc_defaults {
     name: "qva_bta_cc_defaults",
     soong_config_variables: {
         aosp_or_qva: {
           qva: {
             static_libs: [
               "libosi",
               "libbt-utils", 
             ],
           }
        }
    }
}

cc_library_static {
    name: "libbt-bta-ext",
    defaults: ["fluoride_defaults_qti", "qva_bta_cc_defaults"],
    header_libs: ["opensource_commonsys_system_bt_all_inc", "opensource_commonsys_bt_ext_all_inc",
        "opensource_btext_vhal_inc", "opensource_commonsys_intf_bluetooth_inc",
    ],
    srcs: [
        "tws_plus/bta_tws_plus_main.cc",
        "tws_plus/bta_tws_plus_act.cc",
        "tws_plus/bta_tws_plus_api.cc",
        "ba/bta_ba.cc",
        "tws_plus/ag/bta_ag_twsp_dev.cc",
        "tws_plus/ag/bta_ag_twsp_sco.cc",
        "swb/bta_ag_swb.cc"
    ],
    shared_libs: [
        "libcutils",
        "libutils",
        "libhardware",
    ],
    cflags: ["-DBUILDCFG"],
}
