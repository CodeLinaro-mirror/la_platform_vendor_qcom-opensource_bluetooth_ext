// Bluetooth stack static library for target
// ========================================================
cc_library_static {
    name: "libbt-stack_ext",
    defaults: ["fluoride_defaults_qti"],
    local_include_dirs: [
        "btm",
        "include",
    ],
    header_libs: [
        "opensource_btext_vhal_inc",
        "opensource_commonsys_bt_ext_all_inc",
		    "opensource_commonsys_intf_bluetooth_inc",
		    "opensource_commonsys_system_bt_all_inc",
    ],
    srcs: [
        "btm/btm_csb.cc",
        "btm/btm_iot_config.cc",
        "hcic/hcivendorcmds.cc",
        "a2dp/a2dp_vendor_aptx_tws_encoder.cc",
        "a2dp/a2dp_vendor_aptx_tws.cc",
    ],
    static_libs: [
        "libbt-hci_qti",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
}
