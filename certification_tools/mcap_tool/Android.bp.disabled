cc_binary {
    name: "mcap_tool_qti_internal",
    system_ext_specific: true,

    srcs: ["mcap_tool.cpp"],

    include_dirs: [
        "external/libchrome",
    ],
	header_libs: [
	    "opensource_commonsys_bt_ext_all_inc",
		"opensource_commonsys_system_bt_all_inc",
		"opensource_btext_vhal_inc",
	],
    cflags: ["-DHAS_NO_BDROID_BUILDCFG"],

    shared_libs: [
        "libcutils",
        "libchrome",
        "libutils",
    ],

    static_libs: ["libbluetooth-types"],

}
