cc_binary {
    name: "l2cap_coc_tool",
    system_ext_specific: true,

    srcs: ["l2c_coc_test.cpp"],

    include_dirs: [
        "packages/modules/Bluetooth/system/include/",
        "external/libchrome",
    ],
    header_libs: [
        "opensource_commonsys_bt_ext_all_inc",
        "opensource_commonsys_system_bt_all_inc",
        "opensource_btext_vhal_inc",
    ],
    cflags: ["-DHAS_NO_BDROID_BUILDCFG"],

    shared_libs: [
        "libcutils",
        "libchrome",
        "libutils",
    ],

    static_libs: ["libbluetooth-types"],

}
